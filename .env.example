# Environment Configuration for DApp-ALU
# Copy this file to .env and fill in your actual values

# Ethereum Network RPC URL (get from Infura, Alchemy, or other provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the account you want to deploy from (WITHOUT 0x prefix)
# ⚠️ WARNING: Never commit this to git! Use a test wallet only!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Example values (DO NOT USE THESE):
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/abcd1234efgh5678ijkl9012mnop3456
# PRIVATE_KEY=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
